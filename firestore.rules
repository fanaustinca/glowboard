rules_version = '2';

// GlowBoard Firestore rules — closed system, Google sign-in only.
// Paste into Firebase console → Firestore → Rules, or `firebase deploy --only firestore:rules`.
//
// Access list: access/{gmail} (document ID = the lowercase Google email) holds { role, teamId?, name?, addedBy }.
//   admin  → everything. Creates events, picks each event's hosts, grants admin / host / judge / coach by gmail.
//   host   → NOT a separate person type: a modifier an admin gives someone for specific events
//            (eventHosts/{eventId}.emails + host:true on their access doc). The same person can also be a coach,
//            member or judge. Per hosted event they add teams, choose which teams compete, generate the schedule,
//            add referees/judges for that event and enter official scores.
//   referee/judge → ALSO a per-event modifier (eventJudges/{eventId}.emails): anyone with an access doc — a coach, a
//            member — can referee a specific event. The `judge` base role is for people who are only referees
//            (optional eventIds limits them to those events; none = every event).
//   Teams: a person can be on MANY teams, with a role per team (roster/{teamId}__{gmail} = coach | member).
//   coach  → only for the teams where the roster says so (an admin/host/judge can be a coach too). A coach renames the
//            team, picks its colors, adds/removes coaches and members, sets/turns off the team password. Google only.
//   member → practice + stats for that team. Added by a coach by gmail, or joined with the team's shared password
//            (teamMembers/{uid}_{teamId}; works anonymously or on a Google account). Never elevated.
// Anyone can read teams, events and official scores (public dashboard). Nobody can write without an access doc.
// Bootstrap: create the first admin's access/{gmail} document by hand in the console (README → First admin).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }
    // Team-password membership: teamMembers/{uid}_{teamId} stores the password the person used. It only counts while
    // it still equals the team's CURRENT password and the coach hasn't turned password sign-in off.
    function isAnon() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function viaTeamPassword(teamId) {
      return request.auth != null && (isAnon() || hasAccess())
        && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid + '_' + teamId))
        && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid + '_' + teamId)).data.password
          == get(/databases/$(database)/documents/teamSecrets/$(teamId)).data.password
        && get(/databases/$(database)/documents/teamSecrets/$(teamId)).data.get('enabled', true) == true;
    }
    function myDoc() {
      return get(/databases/$(database)/documents/access/$(request.auth.token.email));
    }
    function hasAccess() {
      return signedIn() && exists(/databases/$(database)/documents/access/$(request.auth.token.email));
    }
    function myRole() {
      return myDoc().data.role;
    }
    function isAdmin() {
      return hasAccess() && myRole() == 'admin';
    }
    function isRefereeOf(eventId) {
      return hasAccess()
        && request.auth.token.email in get(/databases/$(database)/documents/eventJudges/$(eventId)).data.get('emails', []);
    }
    // May enter official scores for this event: admins, anyone listed as its referee, or a referee account that was
    // created for it (eventIds). Nobody gets every event by default.
    function isJudgeFor(eventId) {
      return isAdmin() || isRefereeOf(eventId)
        || (hasAccess() && myRole() == 'judge'
          && myDoc().data.get('eventIds', []) is list && eventId in myDoc().data.get('eventIds', []));
    }
    // "Host" = flagged by an admin (host: true) or the host-only base role.
    function isHostAny() {
      return hasAccess() && (myRole() == 'host' || myDoc().data.get('host', false) == true);
    }
    function isHostOf(eventId) {
      return hasAccess()
        && request.auth.token.email in get(/databases/$(database)/documents/eventHosts/$(eventId)).data.get('emails', []);
    }
    // Per-team roles live in roster/{teamId}__{gmail}.
    function rosterDoc(teamId) {
      return /databases/$(database)/documents/roster/$(teamId + '__' + request.auth.token.email);
    }
    function onRoster(teamId) {
      return hasAccess() && exists(rosterDoc(teamId));
    }
    function coachOf(teamId) {
      return onRoster(teamId) && get(rosterDoc(teamId)).data.role == 'coach';
    }
    function onTeam(teamId) {
      return onRoster(teamId) || viaTeamPassword(teamId);
    }
    function teamCreator(teamId) {
      return isHostAny()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.get('createdBy', '') == request.auth.token.email;
    }
    function validSecret(d) {
      return d.password is string && d.password.size() >= 6 && d.password.size() <= 64
        && d.keys().hasOnly(['password', 'updatedBy', 'updatedAt', 'enabled', 'isDefault'])
        && d.get('enabled', true) is bool && d.get('isDefault', false) is bool
        && d.updatedBy == request.auth.token.email;
    }

    // Highest possible Robot Game score is under 1100 in either edition (see js/scoring.js maxScores()).
    function validTotal(v) {
      return v is int && v >= 0 && v <= 5000;
    }
    // Editions: 'founders' (standard) and 'future'. Missing = founders (data from before editions existed).
    function validEdition(v) {
      return v in ['founders', 'future'];
    }
    function validEditions(l) {
      return l is list && l.size() >= 1 && l.size() <= 2 && l.hasOnly(['founders', 'future']);
    }
    function validName(v) {
      return v is string && v.size() > 0 && v.size() <= 60;
    }
    function hexColor(v) {
      return v is string && v.size() == 7 && v.matches('^#[0-9a-fA-F]+$');
    }
    // up to 3 team colors, each like #1a9e6b
    function validColors(c) {
      return c is list && c.size() <= 3
        && (c.size() < 1 || hexColor(c[0])) && (c.size() < 2 || hexColor(c[1])) && (c.size() < 3 || hexColor(c[2]));
    }
    function validTeam(d) {
      return d.number is int && d.number > 0 && validName(d.name) && validColors(d.get('colors', [])) && validEdition(d.get('edition', 'founders'));
    }

    match /access/{email} {
      allow get: if signedIn()
        && (request.auth.token.email == email || isAdmin()
          || (isHostAny() && resource.data.get('addedBy', '') == request.auth.token.email));
      allow list: if isAdmin()
        || (isHostAny() && resource.data.role == 'judge' && resource.data.addedBy == request.auth.token.email);
      allow create: if (isAdmin()
          && email == email.lower()
          && request.resource.data.role in ['admin', 'host', 'judge', 'coach', 'member']
          && (request.resource.data.role in ['admin', 'host', 'judge'] || request.resource.data.teamId is string))
        || (coachOf(request.resource.data.teamId)
          && email == email.lower()
          && request.resource.data.role == 'member'
          && request.resource.data.keys().hasOnly(['role', 'teamId', 'name', 'addedBy', 'addedAt'])
          && request.resource.data.addedBy == request.auth.token.email)
        || (isHostAny()
          && email == email.lower()
          && request.resource.data.role == 'coach'
          && request.resource.data.keys().hasOnly(['role', 'teamId', 'name', 'addedBy', 'addedAt'])
          && request.resource.data.addedBy == request.auth.token.email
          && request.resource.data.teamId is string
          && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.get('createdBy', '') == request.auth.token.email)
        || (isHostAny()
          && email == email.lower()
          && request.resource.data.role == 'judge'
          && request.resource.data.keys().hasOnly(['role', 'name', 'addedBy', 'addedAt', 'eventIds'])
          && request.resource.data.addedBy == request.auth.token.email
          && request.resource.data.eventIds is list
          && request.resource.data.eventIds.size() == 1
          && isHostOf(request.resource.data.eventIds[0]));
      allow update: if isAdmin();
      allow delete: if (isAdmin() && request.auth.token.email != email)
        || (isHostAny() && resource.data.role == 'judge' && resource.data.get('addedBy', '') == request.auth.token.email);
    }

    // Who is on which team, and as what. The document id is "<teamId>__<gmail>".
    // A coach manages their own teams' rosters; people can leave (members only); admins manage everything.
    match /roster/{rid} {
      allow read: if signedIn()
        && (resource.data.email == request.auth.token.email || isAdmin() || coachOf(resource.data.teamId));
      allow create: if hasAccess()
        && request.resource.data.teamId is string
        && request.resource.data.email is string
        && rid == request.resource.data.teamId + '__' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['member', 'coach']
        && request.resource.data.keys().hasOnly(['teamId', 'email', 'role', 'name', 'addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.token.email
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
        && (isAdmin() || coachOf(request.resource.data.teamId)
          || (teamCreator(request.resource.data.teamId) && request.resource.data.role == 'coach'));
      // Admins may change anyone's role on any team (promote to coach / make a member) but not move or re-key the entry.
      allow update: if (isAdmin()
          && request.resource.data.teamId == resource.data.teamId && request.resource.data.email == resource.data.email
          && request.resource.data.role in ['member', 'coach']
          && request.resource.data.keys().hasOnly(['teamId', 'email', 'role', 'name', 'addedBy', 'addedAt']))
        || (coachOf(resource.data.teamId)
          && resource.data.role == 'member' && request.resource.data.role == 'member'
          && request.resource.data.teamId == resource.data.teamId && request.resource.data.email == resource.data.email
          && request.resource.data.keys().hasOnly(['teamId', 'email', 'role', 'name', 'addedBy', 'addedAt']));
      allow delete: if isAdmin()
        || (coachOf(resource.data.teamId) && resource.data.role == 'member')
        || (coachOf(resource.data.teamId) && resource.data.role == 'coach'
          && resource.data.get('addedBy', '') == request.auth.token.email && resource.data.email != request.auth.token.email)
        || (signedIn() && resource.data.email == request.auth.token.email && resource.data.role == 'member');
    }

    // Who hosts which event. Private (hosts' emails are not public): admins, and the hosts listed in the doc.
    match /eventHosts/{eventId} {
      allow get, list: if isAdmin() || (isHostAny() && request.auth.token.email in resource.data.emails);
      allow write: if isAdmin() && request.resource.data.emails is list;
    }

    // Per-event referees (modifier). Managed by admins and by that event's hosts; each person can see their own entries.
    match /eventJudges/{eventId} {
      allow get: if isAdmin() || isHostOf(eventId)
        || (hasAccess() && request.auth.token.email in resource.data.emails);
      allow list: if isAdmin() || (hasAccess() && request.auth.token.email in resource.data.emails);
      allow write: if (isAdmin() || isHostOf(eventId)) && request.resource.data.emails is list;
    }

    // The shared team password. Only the team's coaches and admins can SEE it; the host who created the team can only replace it.
    match /teamSecrets/{teamId} {
      allow read: if isAdmin() || coachOf(teamId);
      allow create, update: if (isAdmin() || coachOf(teamId) || teamCreator(teamId)) && validSecret(request.resource.data);
      allow delete: if isAdmin();
    }

    // "I know the team password" memberships (anonymous or Google): teamMembers/{uid}_{teamId}.
    // The password in the doc must match the team's current one, and the coach must not have turned it off.
    match /teamMembers/{memberId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin() || coachOf(resource.data.teamId));
      allow create, update: if request.auth != null && (isAnon() || hasAccess())
        && request.resource.data.keys().hasOnly(['uid', 'teamId', 'password', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.teamId is string
        && memberId == request.auth.uid + '_' + request.resource.data.teamId
        && request.resource.data.password == get(/databases/$(database)/documents/teamSecrets/$(request.resource.data.teamId)).data.password
        && get(/databases/$(database)/documents/teamSecrets/$(request.resource.data.teamId)).data.get('enabled', true) == true
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 40;
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin() || coachOf(resource.data.teamId));
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin() && validEditions(request.resource.data.get('editions', ['founders'])) && request.resource.data.get('test', false) is bool;
      allow delete: if isAdmin();
      // A host may only change the team list and the schedule of an event they host.
      allow update: if (isAdmin() && validEditions(request.resource.data.get('editions', ['founders'])) && request.resource.data.get('test', false) is bool)
        || (isHostOf(eventId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamIds', 'schedule']));
    }

    match /teams/{teamId} {
      allow read: if true;
      // Hosts add teams the same way admins do (and own the ones they created).
      allow create: if (isAdmin() || isHostAny()) && validTeam(request.resource.data)
        && request.resource.data.createdBy == request.auth.token.email
        && teamId == 't' + string(request.resource.data.number);
      allow delete: if isAdmin() || (isHostAny() && resource.data.get('createdBy', '') == request.auth.token.email);
      allow update: if (isAdmin() && validTeam(request.resource.data))
        || (isHostAny() && resource.data.get('createdBy', '') == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && validName(request.resource.data.name))
        || (coachOf(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'colors'])
          && validName(request.resource.data.name)
          && validColors(request.resource.data.get('colors', [])));
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow create: if (isJudgeFor(request.resource.data.eventId) || isHostOf(request.resource.data.eventId))
        && request.resource.data.judgeUid == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.teamId is string
        && request.resource.data.round in [1, 2, 3]
        && scoreId == request.resource.data.eventId + '_' + request.resource.data.teamId + '_R' + string(request.resource.data.round)
        && validTotal(request.resource.data.total)
        && request.resource.data.gp in [2, 3, 4]
        && validEdition(request.resource.data.get('edition', 'founders'))
        && request.resource.data.hasSignature == true
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId));
      // Judges can't replace or remove a score. Only the event's host or an admin can delete it (so it can be re-scored).
      allow update: if isAdmin();
      allow delete: if isAdmin() || isHostOf(resource.data.eventId);
    }

    // Signatures are drawn by (often young) team members: only that event's referees, hosts and admins may read them.
    // (the doc id is "<eventId>_<teamId>_R<n>", and event ids contain no underscore)
    match /signatures/{scoreId} {
      allow read: if isJudgeFor(scoreId.split('_')[0]) || isHostOf(scoreId.split('_')[0]);
      allow create: if (isJudgeFor(scoreId.split('_')[0]) || isHostOf(scoreId.split('_')[0]))
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0
        && request.resource.data.signature.size() < 200000;
      allow update: if isAdmin();
      allow delete: if isAdmin() || isHostOf(scoreId.split('_')[0]);
    }

    // Practice runs belong to a team: its coaches and members (and admins) can read them.
    match /practice/{runId} {
      allow read: if isAdmin() || onTeam(resource.data.teamId);
      allow create: if onTeam(request.resource.data.teamId)
        && request.resource.data.uid == request.auth.uid
        && validEdition(request.resource.data.get('edition', 'founders'))
        && validTotal(request.resource.data.total);
      // Anyone on the team can edit or delete the team's practice runs.
      allow delete: if isAdmin() || onTeam(resource.data.teamId);
      allow update: if onTeam(resource.data.teamId)
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && validTotal(request.resource.data.total);
    }

    // ── Live help chat ─────────────────────────────────────────────────────────────────────────
    // Anyone (signed in or not) can ask for help. A conversation lives at helpThreads/{threadId}; the id is a long random
    // string kept in the asker's browser, so only they (and admins) can find it: `get` is open, `list` is admin-only.
    // Only admins reply (from == 'admin') and only admins can delete or resolve.
    function validHelpId(tid) { return tid.size() >= 20 && tid.size() <= 48; }
    function helpText(v) { return v is string && v.size() >= 1 && v.size() <= 500; }
    function helpEmailOk(v) {
      return v == '' || (request.auth != null && request.auth.token.get('email', '') == v);
    }
    match /helpThreads/{tid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validHelpId(tid)
        && request.resource.data.keys().hasOnly(['name', 'contact', 'email', 'createdAt', 'lastAt', 'lastFrom', 'last', 'resolved'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.email is string && helpEmailOk(request.resource.data.email)
        && request.resource.data.createdAt is int && request.resource.data.lastAt is int
        && request.resource.data.lastFrom == 'user' && request.resource.data.resolved == false
        && request.resource.data.last is string && request.resource.data.last.size() <= 100;
      allow update: if isAdmin()
        || (validHelpId(tid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'contact', 'email', 'lastAt', 'lastFrom', 'last', 'resolved'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
          && request.resource.data.email is string && helpEmailOk(request.resource.data.email)
          && request.resource.data.lastAt is int && request.resource.data.lastFrom == 'user' && request.resource.data.resolved == false
          && request.resource.data.last is string && request.resource.data.last.size() <= 100);
      allow delete: if isAdmin();

      match /msgs/{mid} {
        allow get, list: if true;
        allow create: if validHelpId(tid)
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
          && helpText(request.resource.data.text) && request.resource.data.createdAt is int
          && ((request.resource.data.from == 'user') || (request.resource.data.from == 'admin' && isAdmin()));
        allow update, delete: if isAdmin();
      }
    }
  }
}
